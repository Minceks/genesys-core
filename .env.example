DAYTONA_API_KEY=

GROQ_API_KEY=

GEMINI_API_KEY=

GENESYS_MODEL=openai/gpt-oss-120b

GENESYS_GEMINI_MODEL=gemini-3.8-flash

GENESYS_PROVIDER=groq

GENESYS_FALLBACK_PROVIDER=gemini

GENESYS_CORS_ORIGINS=*

GENESYS_API_KEY=

# Optional. Enables verified checkpoint promotion through a review PR.
# Use a fine-grained token restricted to this repository with Contents: Read and write
# and Pull requests: Read and write permissions.
GENESYS_GITHUB_TOKEN=
GENESYS_GITHUB_REPOSITORY=Minceks/genesys-core
GENESYS_GITHUB_BASE_BRANCH=main
# Generate a separate random secret for short-lived verified checkpoint proofs.
GENESYS_PROMOTION_SIGNING_KEY=

# Frontend build variable. Must match GENESYS_API_KEY.
# Values prefixed with VITE_ are included in the browser bundle.
VITE_CLOUD_AGENT_API_KEY=

# Configuring Supabase enables bearer authentication with ownership checks.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated user UUIDs allowed to promote to the shared production repo.
GENESYS_PROMOTION_ADMIN_IDS=
# Beta build limits (per backend replica; counters reset on restart).
GENESYS_BUILDS_PER_HOUR=5
GENESYS_BUILDS_PER_DAY=20
GENESYS_BUILD_COOLDOWN_SECONDS=10

# Quality profile: more room for complete implementations and separate review.
GENESYS_REASONING_EFFORT=medium
GENESYS_REVIEW_REASONING_EFFORT=medium
GENESYS_INPUT_TOKEN_LIMIT=48000
GENESYS_OUTPUT_TOKEN_LIMIT=12000
GENESYS_OUTPUT_TOKEN_CEILING=24000
GENESYS_BACKGROUND_TIMEOUT_SECONDS=900
GENESYS_DESIGN_MODEL=gpt-5.4
GENESYS_VISUAL_REVIEW_MODEL=gpt-5.4

# Completed builds are stored on the backend volume, independent of sandbox lifetime.
# Set this to the mounted Railway volume path in production (for example /data).
RAILWAY_VOLUME_MOUNT_PATH=
GENESYS_PREVIEW_DOMAIN=
GENESYS_PREVIEW_PROXY_URL=
# Server secret shared only by the backend and isolated preview service. Never VITE_.
GENESYS_PREVIEW_PROXY_KEY=
# Set on the preview service to the public HTTPS backend URL.
GENESYS_PUBLISHED_BACKEND_URL=
# Optional one-time migration of existing verified snapshots; no paid AI builds.
GENESYS_MIGRATE_COMPLETED_PREVIEWS=0
# Inspect one public design reference for a new build or requested redesign.
# Uses a supplied reference URL or a fetched curated reference; repairs reuse evidence.
# No additional model calls. Disable to skip reference browser/REA inspection.
GENESYS_REFERENCE_INSPECTION=1
# Screenshot judgment: at most two vision calls and one polish opportunity per build.
# Uses the configured OpenAI model unless a vision-capable model is set here.
GENESYS_VISUAL_REVIEW=1
GENESYS_VISUAL_REVIEW_MODEL=

# Post-deployment checks of persisted previews. Server-only; never use VITE_.
GENESYS_DEPLOY_SMOKE_ENABLED=1
GENESYS_DEPLOY_SMOKE_KEY=
# Same backend HTTPS URL on backend, frontend host, and preview router.
GENESYS_SMOKE_BACKEND_URL=
# Canonical frontend URL used to wait for its own deployment before notifying.
GENESYS_SMOKE_FRONTEND_URL=

GENESYS_DESIGN_OUTPUT_TOKEN_LIMIT=24000

# Browser planning runs separately from full build reasoning.
GENESYS_VERIFICATION_MODEL=gpt-5.4
GENESYS_VERIFICATION_REASONING_EFFORT=low
GENESYS_VERIFICATION_OUTPUT_TOKEN_LIMIT=8000
# Optional: report backend errors to Sentry.
SENTRY_DSN=
