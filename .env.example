DAYTONA_API_KEY=

GROQ_API_KEY=

GEMINI_API_KEY=

GENESYS_MODEL=openai/gpt-oss-120b

GENESYS_GEMINI_MODEL=gemini-3.8-flash

GENESYS_PROVIDER=groq

GENESYS_FALLBACK_PROVIDER=gemini

GENESYS_CORS_ORIGINS=*

GENESYS_API_KEY=

# Optional. Enables verified checkpoint promotion through a review PR.
# Use a fine-grained token restricted to this repository with Contents: Read and write
# and Pull requests: Read and write permissions.
GENESYS_GITHUB_TOKEN=
GENESYS_GITHUB_REPOSITORY=Minceks/genesys-core
GENESYS_GITHUB_BASE_BRANCH=main
# Generate a separate random secret for short-lived verified checkpoint proofs.
GENESYS_PROMOTION_SIGNING_KEY=

# Frontend build variable. Must match GENESYS_API_KEY.
# Values prefixed with VITE_ are included in the browser bundle.
VITE_CLOUD_AGENT_API_KEY=

# Configuring Supabase enables bearer authentication with ownership checks.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated user UUIDs allowed to promote to the shared production repo.
GENESYS_PROMOTION_ADMIN_IDS=
# Beta build limits (per backend replica; counters reset on restart).
GENESYS_BUILDS_PER_HOUR=5
GENESYS_BUILDS_PER_DAY=20
GENESYS_BUILD_COOLDOWN_SECONDS=10
