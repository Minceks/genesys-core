{
    "$schema":  "https://schema.railpack.com",
    "provider":  "python",
    "packages":  {
                     "node":  "24"
                 },
    "steps":  {
                  "build":  {
                                "commands":  [
                                                 "npm ci --prefix reference_tools --omit=dev --ignore-scripts --no-audit --no-fund",
                                                 "python scripts/check_reference_runtime.py --browser"
                                             ]
                            }
              },
    "buildAptPackages":  [
                             "libglib2.0-0",
                             "libnss3",
                             "libnspr4",
                             "libdbus-1-3",
                             "libatk1.0-0",
                             "libatk-bridge2.0-0",
                             "libcups2",
                             "libdrm2",
                             "libxcb1",
                             "libxcb-shm0",
                             "libxkbcommon0",
                             "libatspi2.0-0",
                             "libx11-6",
                             "libx11-xcb1",
                             "libxcomposite1",
                             "libxdamage1",
                             "libxext6",
                             "libxfixes3",
                             "libxrandr2",
                             "libgbm1",
                             "libpango-1.0-0",
                             "libcairo2",
                             "libasound2"
                         ]
}
