FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY index.html vite.config.ts ./
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_CLOUD_AGENT_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_CLOUD_AGENT_URL=$VITE_CLOUD_AGENT_URL
RUN test -n "$VITE_SUPABASE_URL" && test -n "$VITE_SUPABASE_PUBLISHABLE_KEY" && test -n "$VITE_CLOUD_AGENT_URL" && npm run build

FROM python:3.14-slim
WORKDIR /app
RUN pip install --no-cache-dir 'Flask>=3,<4' 'gunicorn>=23,<27'
COPY --from=build /app/dist ./dist
COPY frontend_host.py deployment_notify.py ./
ENV PORT=8080
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT} --workers 2 --access-logfile - frontend_host:app"]
